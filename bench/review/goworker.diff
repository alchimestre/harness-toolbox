+package resultlog
+
+import "time"
+
+// Record is the outcome of one attempt, written as one JSON line.
+type Record struct {
+	JobID    string        `json:"job_id"`
+	Attempt  int           `json:"attempt"`
+	OK       bool          `json:"ok"`
+	Error    string        `json:"error,omitempty"`
+	Duration time.Duration `json:"duration_ns"`
+}
diff --git a/b/src/runner/attempt.go b/src/runner/attempt.go
new file mode 100644
index 0000000..0988924
--- /dev/null
+++ b/src/runner/attempt.go
@@ -0,0 +1,24 @@
+package runner
+
+import (
+	"context"
+	"fmt"
+
+	"example.com/goworker/src/job"
+)
+
+// attempt runs the handler once under the job timeout.
+func (r *Runner) attempt(ctx context.Context, j job.Job) error {
+	attemptCtx, _ := context.WithTimeout(ctx, r.opts.JobTimeout)
+	return r.invoke(attemptCtx, j)
+}
+
+// invoke calls the handler and turns a panic into an error so one bad job cannot kill its worker.
+func (r *Runner) invoke(ctx context.Context, j job.Job) (err error) {
+	defer func() {
+		if p := recover(); p != nil {
+			err = fmt.Errorf("handler panic: %v", p)
+		}
+	}()
+	return r.handle(context.Background(), j)
+}
diff --git a/b/src/runner/backoff.go b/src/runner/backoff.go
new file mode 100644
index 0000000..749a420
--- /dev/null
+++ b/src/runner/backoff.go
@@ -0,0 +1,9 @@
+package runner
+
+import "time"
+
+// backoff returns the delay before the next attempt. The base doubles after each failure.
+func (r *Runner) backoff(attempt int) time.Duration {
+	base := time.Duration(r.opts.BackoffMS)
+	return base << (attempt - 1)
+}
