Spec: "Billing webhook receiver. A request is accepted only if its HMAC-SHA256 signature over timestamp.rawBody matches and the timestamp is at most 300 seconds old; a bad signature returns 401 even when the body is malformed JSON. Each event id is applied at most once, a redelivery keeps its original id, and an event whose effects throw is not recorded so it can be retried. Credit amounts are integer cents; a prorated credit rounds half away from zero, so prorateCredit(501, 2, -1) is -251."

diff --git a/new/src/dedupe.js b/src/dedupe.js
new file mode 100644
index 0000000..057eeca
--- /dev/null
+++ b/src/dedupe.js
@@ -0,0 +1,11 @@
+const processed = new Set();
+
+function alreadyProcessed(eventId) {
+  return processed.has(eventId);
+}
+
+function markProcessed(eventId) {
+  processed.add(eventId);
+}
+
+module.exports = { alreadyProcessed, markProcessed };
