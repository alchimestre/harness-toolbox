 }
 
-function verifyToken(token) {
+function verifyWith(token, options) {
   try {
-    return jwt.verify(token, JWT_SECRET, { algorithms: [ALGORITHM] });
+    return jwt.verify(token, JWT_SECRET, options);
   } catch (error) {
